  m_Name: RouteGuidance
  m_EditorClassIdentifier: LWS.FireNotification.Runtime::LWS.FireNotification.Presentation.RouteGuidanceCatalog
  cues:
  - id: ready
    audio: {fileID: 8300000, guid: c6370c2db055aef45a471d363afa9296, type: 3}
    text: "\uD559\uAD50 \uBCF5\uB3C4\uC5D0\uC11C \uB300\uD53C \uACBD\uB85C\uB97C
      \uC120\uD0DD\uD558\uB294 \uC5F0\uC2B5\uC785\uB2C8\uB2E4. \uC900\uBE44\uAC00
      \uB418\uBA74 \uC900\uBE44 \uC644\uB8CC\uB97C \uC120\uD0DD\uD558\uC138\uC694.
      \uBD88\uD3B8\uD558\uBA74 \uC5B8\uC81C\uB4E0 \uBA54\uB274\uC5D0\uC11C \uC911\uB2E8\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    segments:
    - start: 0
      end: 11.911428
      text: "\uD559\uAD50 \uBCF5\uB3C4\uC5D0\uC11C \uB300\uD53C \uACBD\uB85C\uB97C
        \uC120\uD0DD\uD558\uB294 \uC5F0\uC2B5\uC785\uB2C8\uB2E4. \uC900\uBE44\uAC00
        \uB418\uBA74 \uC900\uBE44 \uC644\uB8CC\uB97C \uC120\uD0DD\uD558\uC138\uC694.
        \uBD88\uD3B8\uD558\uBA74 \uC5B8\uC81C\uB4E0 \uBA54\uB274\uC5D0\uC11C \uC911\uB2E8\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: intro-a
    audio: {fileID: 8300000, guid: 0c6c83ae95798fa449f7699266082ab3, type: 3}
    text: "\uC8FC\uBCC0\uC758 \uC720\uB3C4\uD45C\uC9C0\uC640 \uACC4\uB2E8 \uC0C1\uD0DC\uB97C
      \uC0B4\uD3B4\uBCF4\uC138\uC694. \uBC14\uB2E5\uC758 \uC774\uB3D9 \uC9C0\uC810\uC744
      \uAC00\uB9AC\uCF1C \uC21C\uAC04\uC774\uB3D9\uD558\uACE0, \uC785\uAD6C \uC55E
      \uD655\uC778 \uC9C0\uC810\uC5D0\uC11C\uB294 \uC8FC\uBCC0\uC744 \uC0B4\uD540
      \uB4A4 \uD589\uB3D9\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    segments:
    - start: 0
      end: 13.939252
      text: "\uC8FC\uBCC0\uC758 \uC720\uB3C4\uD45C\uC9C0\uC640 \uACC4\uB2E8 \uC0C1\uD0DC\uB97C
        \uC0B4\uD3B4\uBCF4\uC138\uC694. \uBC14\uB2E5\uC758 \uC774\uB3D9 \uC9C0\uC810\uC744
        \uAC00\uB9AC\uCF1C \uC21C\uAC04\uC774\uB3D9\uD558\uACE0, \uC785\uAD6C \uC55E
        \uD655\uC778 \uC9C0\uC810\uC5D0\uC11C\uB294 \uC8FC\uBCC0\uC744 \uC0B4\uD540
        \uB4A4 \uD589\uB3D9\uC744 \uC120\uD0DD\uD558\uC138\uC694."
  - id: intro-b
    audio: {fileID: 8300000, guid: 74ecf343134a51a4a927c12a04bd9758, type: 3}
    text: "\uAC19\uC740 \uD559\uAD50\uC758 \uB2E4\uB978 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uC8FC\uBCC0\uC758 \uD45C\uC9C0\uC640 \uACBD\uB85C \uC0C1\uD0DC\uB97C \uC0B4\uD3B4\uBCF4\uACE0,
      \uC774\uC6A9\uD560 \uB300\uD53C \uACBD\uB85C\uB97C \uC9C1\uC811 \uC120\uD0DD\uD574
      \uBCF4\uC138\uC694."
    segments:
    - start: 0
      end: 10.107165
      text: "\uAC19\uC740 \uD559\uAD50\uC758 \uB2E4\uB978 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
        \uC8FC\uBCC0\uC758 \uD45C\uC9C0\uC640 \uACBD\uB85C \uC0C1\uD0DC\uB97C \uC0B4\uD3B4\uBCF4\uACE0,
        \uC774\uC6A9\uD560 \uB300\uD53C \uACBD\uB85C\uB97C \uC9C1\uC811 \uC120\uD0DD\uD574
        \uBCF4\uC138\uC694."
  - id: elevator
    audio: {fileID: 8300000, guid: d9678723ce563e24bb2a8af1c339777e, type: 3}
    text: "\uD654\uC7AC \uB54C\uB294 \uC815\uC804\uC774\uB098 \uACE0\uC7A5\uC73C\uB85C
      \uAC07\uD788\uAC70\uB098 \uC5F0\uAE30\uC5D0 \uB178\uCD9C\uB420 \uC218 \uC788\uC5B4
      \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uC774\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB978 \uACBD\uB85C\uB97C \uCC3E\uC544\uBCF4\uC138\uC694."
    segments:
    - start: 0
      end: 10.162676
      text: "\uD654\uC7AC \uB54C\uB294 \uC815\uC804\uC774\uB098 \uACE0\uC7A5\uC73C\uB85C
        \uAC07\uD788\uAC70\uB098 \uC5F0\uAE30\uC5D0 \uB178\uCD9C\uB420 \uC218 \uC788\uC5B4
        \uC5D8\uB9AC\uBCA0\uC774\uD130\uB97C \uC774\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
        \uB2E4\uB978 \uACBD\uB85C\uB97C \uCC3E\uC544\uBCF4\uC138\uC694."
  - id: smoke
    audio: {fileID: 8300000, guid: 81fb78b5783511d49b557863de7019ed, type: 3}
    text: "\uC5F0\uAE30\uB85C \uB9C9\uD78C \uACC4\uB2E8\uC5D0 \uBB34\uB9AC\uD558\uAC8C
      \uB4E4\uC5B4\uAC00\uBA74 \uC704\uD5D8\uD569\uB2C8\uB2E4. \uB0AE\uC740 \uC790\uC138\uB9CC\uC73C\uB85C
      \uD1B5\uACFC\uD560 \uC218 \uC788\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.
      \uC774 \uC5F0\uC2B5\uC5D0\uC11C\uB294 \uB2E4\uB978 \uACBD\uB85C\uB97C \uCC3E\uC544\uBCF4\uC138\uC694."
    segments:
    - start: 0
      end: 11.711134
      text: "\uC5F0\uAE30\uB85C \uB9C9\uD78C \uACC4\uB2E8\uC5D0 \uBB34\uB9AC\uD558\uAC8C
        \uB4E4\uC5B4\uAC00\uBA74 \uC704\uD5D8\uD569\uB2C8\uB2E4. \uB0AE\uC740 \uC790\uC138\uB9CC\uC73C\uB85C
        \uD1B5\uACFC\uD560 \uC218 \uC788\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4.
        \uC774 \uC5F0\uC2B5\uC5D0\uC11C\uB294 \uB2E4\uB978 \uACBD\uB85C\uB97C \uCC3E\uC544\uBCF4\uC138\uC694."
  - id: complete-a
    audio: {fileID: 8300000, guid: 8d35327175842014d809a079f570e092, type: 3}
    text: "\uCCAB \uBC88\uC9F8 \uB300\uD53C \uACBD\uB85C \uC120\uD0DD \uC5F0\uC2B5\uC744
      \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. \uACC4\uB2E8\uB3C4 \uC8FC\uBCC0 \uC0C1\uD0DC\uB97C
      \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uB2E4\uC74C \uC5F0\uC2B5\uC5D0\uC11C\uB294
      \uB2E4\uB978 \uAD6C\uC5ED\uC5D0\uC11C \uD310\uB2E8\uD574 \uBCF4\uC138\uC694."
    segments:
    - start: 0
      end: 11.723537
      text: "\uCCAB \uBC88\uC9F8 \uB300\uD53C \uACBD\uB85C \uC120\uD0DD \uC5F0\uC2B5\uC744
        \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. \uACC4\uB2E8\uB3C4 \uC8FC\uBCC0 \uC0C1\uD0DC\uB97C
        \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uB2E4\uC74C \uC5F0\uC2B5\uC5D0\uC11C\uB294
        \uB2E4\uB978 \uAD6C\uC5ED\uC5D0\uC11C \uD310\uB2E8\uD574 \uBCF4\uC138\uC694."
  - id: completion
    audio: {fileID: 8300000, guid: 89865c9a52720be439294129faa01305, type: 3}
    text: "\uB450 \uC0C1\uD669\uC758 \uB300\uD53C \uACBD\uB85C \uC120\uD0DD \uC5F0\uC2B5\uC744
      \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. \uC5F0\uAE30\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uB294
      \uAC83\uB9CC\uC73C\uB85C \uC2E4\uC81C \uC548\uC804\uC744 \uBCF4\uC7A5\uD558\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4. \uC2E4\uC81C \uAC74\uBB3C \uD0C8\uCD9C\uC744 \uC644\uB8CC\uD55C
      \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uBAA8\uB4E0 \uACBD\uB85C\uAC00 \uB9C9\uD78C
      \uACBD\uC6B0\uC758 \uB300\uCC98\uB294 \uBCC4\uB3C4 \uAD50\uC721\uC5D0\uC11C
      \uB2E4\uB8F9\uB2C8\uB2E4."
    segments:
    - start: 0
      end: 18.306553
      text: "\uB450 \uC0C1\uD669\uC758 \uB300\uD53C \uACBD\uB85C \uC120\uD0DD \uC5F0\uC2B5\uC744
        \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. \uC5F0\uAE30\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uB294
        \uAC83\uB9CC\uC73C\uB85C \uC2E4\uC81C \uC548\uC804\uC744 \uBCF4\uC7A5\uD558\uC9C0\uB294
        \uC54A\uC2B5\uB2C8\uB2E4. \uC2E4\uC81C \uAC74\uBB3C \uD0C8\uCD9C\uC744 \uC644\uB8CC\uD55C
        \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uBAA8\uB4E0 \uACBD\uB85C\uAC00 \uB9C9\uD78C
        \uACBD\uC6B0\uC758 \uB300\uCC98\uB294 \uBCC4\uB3C4 \uAD50\uC721\uC5D0\uC11C
        \uB2E4\uB8F9\uB2C8\uB2E4."
