  m_Name: GuidanceCatalog
  m_EditorClassIdentifier: LWS.FireNotification.Runtime::LWS.FireNotification.Presentation.GuidanceCatalog
  cues:
  - id: situation
    audio: {fileID: 8300000, guid: 6ae26424d4fb4e44c81417573da07935, type: 3}
    text: "\uC9C0\uAE08 \uC774 \uBCF5\uB3C4\uC5D0\uC11C \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC5B4\uC694.
      \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC744 \uD55C\uBC88 \uBCFC\uAE4C\uC694? \uC544\uC9C1
      \uD654\uC7AC\uB97C \uC54C\uC544\uCC28\uB9AC\uC9C0 \uBABB\uD55C \uAC83 \uAC19\uB124\uC694.
      \uC774 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uD654\uC7AC\uAC00 \uB0AC\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uC5B4\uB5BB\uAC8C \uC54C\uB9AC\uBA74 \uC88B\uC744\uAE4C\uC694?"
    segments:
    - start: 0
      end: 3.356009
      text: "\uC9C0\uAE08 \uC774 \uBCF5\uB3C4\uC5D0\uC11C \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC5B4\uC694."
    - start: 3.596009
      end: 6.1879363
      text: "\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC744 \uD55C\uBC88 \uBCFC\uAE4C\uC694?"
    - start: 6.4279366
      end: 9.794739
      text: "\uC544\uC9C1 \uD654\uC7AC\uB97C \uC54C\uC544\uCC28\uB9AC\uC9C0 \uBABB\uD55C
        \uAC83 \uAC19\uB124\uC694."
    - start: 10.0347395
      end: 14.80449
      text: "\uC774 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uD654\uC7AC\uAC00 \uB0AC\uB2E4\uB294
        \uC0AC\uC2E4\uC744 \uC5B4\uB5BB\uAC8C \uC54C\uB9AC\uBA74 \uC88B\uC744\uAE4C\uC694?"
  - id: next
    audio: {fileID: 8300000, guid: bed0f60f3fb40a2448a20672f394004d, type: 3}
    text: "\uC0AC\uB78C\uB4E4\uC774 \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uBC18\uC751\uD558\uAE30
      \uC2DC\uC791\uD588\uB124\uC694. \uD654\uC7AC\uB97C \uBC1C\uACAC\uD574\uB3C4
      \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC740 \uC544\uC9C1 \uBAA8\uB974\uACE0 \uC788\uC744
      \uC218 \uC788\uC5B4\uC694. \u2018\uBD88\uC774\uC57C!\u2019\uB77C\uACE0 \uD06C\uAC8C
      \uC678\uCE58\uBA74 \uD654\uC7AC\uAC00 \uB0AC\uB2E4\uB294 \uC0AC\uC2E4\uC744
      \uC54C\uB9B4 \uC218 \uC788\uC8E0. \uC774\uBC88\uC5D0\uB294 \uAC19\uC740 \uC0C1\uD669\uC5D0\uC11C
      \uBE44\uC0C1\uBCA8\uC744 \uC774\uC6A9\uD574 \uBCFC\uAE4C\uC694? \uC900\uBE44\uB418\uBA74
      \u2018\uB2E4\uC74C\u2019\uC744 \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    segments:
    - start: 0
      end: 21.368504
      text: "\uC0AC\uB78C\uB4E4\uC774 \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uBC18\uC751\uD558\uAE30
        \uC2DC\uC791\uD588\uB124\uC694. \uD654\uC7AC\uB97C \uBC1C\uACAC\uD574\uB3C4
        \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC740 \uC544\uC9C1 \uBAA8\uB974\uACE0 \uC788\uC744
        \uC218 \uC788\uC5B4\uC694. \u2018\uBD88\uC774\uC57C!\u2019\uB77C\uACE0 \uD06C\uAC8C
        \uC678\uCE58\uBA74 \uD654\uC7AC\uAC00 \uB0AC\uB2E4\uB294 \uC0AC\uC2E4\uC744
