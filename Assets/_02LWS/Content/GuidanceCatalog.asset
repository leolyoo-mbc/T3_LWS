        \uBE44\uC0C1\uBCA8\uC744 \uC774\uC6A9\uD574 \uBCFC\uAE4C\uC694? \uC900\uBE44\uB418\uBA74
        \u2018\uB2E4\uC74C\u2019\uC744 \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
  - id: bell
    audio: {fileID: 8300000, guid: 0b12b5a586d7dd842bc2c219d5c56ce9, type: 3}
    text: "\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC774 \uC544\uC9C1 \uD654\uC7AC\uB97C
      \uBAA8\uB974\uB294 \uC0C1\uD669\uC73C\uB85C \uB3CC\uC544\uC654\uC5B4\uC694.
      \uBE44\uC0C1\uBCA8\uB3C4 \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC54C\uB9AC\uB294
      \uBC29\uBC95\uC774\uC5D0\uC694. \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uACBD\uBCF4\uC74C\uC774
      \uC6B8\uB824 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC54C\uB9B4 \uC218
      \uC788\uC8E0. \uC9C1\uC811 \uB20C\uB7EC \uBCF4\uACE0 \uC0AC\uB78C\uB4E4\uC774
      \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD558\uB294\uC9C0 \uC0B4\uD3B4\uBCFC\uAE4C\uC694?
      \uCEE8\uD2B8\uB864\uB7EC\uB85C \uC190\uC744 \uC6C0\uC9C1\uC5EC \uBE44\uC0C1\uBCA8
      \uBC84\uD2BC\uC744 \uBC00\uC5B4 \uB20C\uB7EC \uBCF4\uC138\uC694."
    segments:
    - start: 0
      end: 23.013039
      text: "\uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC774 \uC544\uC9C1 \uD654\uC7AC\uB97C
        \uBAA8\uB974\uB294 \uC0C1\uD669\uC73C\uB85C \uB3CC\uC544\uC654\uC5B4\uC694.
        \uBE44\uC0C1\uBCA8\uB3C4 \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC54C\uB9AC\uB294
        \uBC29\uBC95\uC774\uC5D0\uC694. \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uACBD\uBCF4\uC74C\uC774
        \uC6B8\uB824 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC54C\uB9B4 \uC218
        \uC788\uC8E0. \uC9C1\uC811 \uB20C\uB7EC \uBCF4\uACE0 \uC0AC\uB78C\uB4E4\uC774
        \uC5B4\uB5BB\uAC8C \uBC18\uC751\uD558\uB294\uC9C0 \uC0B4\uD3B4\uBCFC\uAE4C\uC694?
        \uCEE8\uD2B8\uB864\uB7EC\uB85C \uC190\uC744 \uC6C0\uC9C1\uC5EC \uBE44\uC0C1\uBCA8
        \uBC84\uD2BC\uC744 \uBC00\uC5B4 \uB20C\uB7EC \uBCF4\uC138\uC694."
  - id: completion
    audio: {fileID: 8300000, guid: caad2e7514149234bbbfd288f022bc44, type: 3}
    text: "\uACBD\uBCF4\uC74C\uC744 \uB4E3\uACE0 \uC0AC\uB78C\uB4E4\uC774 \uD558\uB358
      \uD589\uB3D9\uC744 \uBA48\uCDC4\uB124\uC694. \uC774\uBC88\uC5D0\uB294 \uBAA9\uC18C\uB9AC
      \uB300\uC2E0 \uBE44\uC0C1\uBCA8\uB85C \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC804\uD588\uC5B4\uC694.
      \uC55E\uC5D0\uC11C\uB294 \uD070\uC18C\uB9AC\uB85C \uC678\uCCE4\uACE0, \uC774\uBC88\uC5D0\uB294
      \uBE44\uC0C1\uBCA8\uC744 \uB20C\uB800\uC8E0. \uB450 \uD589\uB3D9 \uBAA8\uB450
      \uC8FC\uBCC0\uC5D0 \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC54C\uB9AC\uAE30 \uC704\uD55C
      \uBC29\uBC95\uC774\uC5D0\uC694. \uC624\uB298 \uCCB4\uD5D8\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC608\uC694.
      \uC900\uBE44\uB418\uBA74 \uBA54\uB274\uB85C \uB3CC\uC544\uAC00 \uC8FC\uC138\uC694."
    segments:
    - start: 0
      end: 24.720545
      text: "\uACBD\uBCF4\uC74C\uC744 \uB4E3\uACE0 \uC0AC\uB78C\uB4E4\uC774 \uD558\uB358
        \uD589\uB3D9\uC744 \uBA48\uCDC4\uB124\uC694. \uC774\uBC88\uC5D0\uB294 \uBAA9\uC18C\uB9AC
        \uB300\uC2E0 \uBE44\uC0C1\uBCA8\uB85C \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC804\uD588\uC5B4\uC694.
        \uC55E\uC5D0\uC11C\uB294 \uD070\uC18C\uB9AC\uB85C \uC678\uCCE4\uACE0, \uC774\uBC88\uC5D0\uB294
        \uBE44\uC0C1\uBCA8\uC744 \uB20C\uB800\uC8E0. \uB450 \uD589\uB3D9 \uBAA8\uB450
        \uC8FC\uBCC0\uC5D0 \uD654\uC7AC \uC0AC\uC2E4\uC744 \uC54C\uB9AC\uAE30 \uC704\uD55C
        \uBC29\uBC95\uC774\uC5D0\uC694. \uC624\uB298 \uCCB4\uD5D8\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC608\uC694.
        \uC900\uBE44\uB418\uBA74 \uBA54\uB274\uB85C \uB3CC\uC544\uAC00 \uC8FC\uC138\uC694."
  - id: feedback
    audio: {fileID: 8300000, guid: 52d791b33af59624db219655509a054b, type: 3}
    text: "\uAE30\uB2E4\uB9AC\uAE30\uB9CC \uD558\uBA74 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC774
      \uD654\uC7AC\uB97C \uC54C\uC544\uCC28\uB9AC\uC9C0 \uBABB\uD560 \uC218 \uC788\uC5B4\uC694.
